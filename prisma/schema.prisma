datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// 1. NGƯỜI DÙNG & PHÂN QUYỀN
model User {
  id           String      @id @default(uuid())
  username     String      @unique
  passwordHash String
  fullName     String
  email        String?
  phone        String?
  role         String      // 'Admin' | 'Thu Ngân' | 'Thủ Kho' | 'Kế Toán' | 'Quản Lý' | 'Bán Hàng'
  status       String      @default("active") // 'active' | 'inactive'
  avatar       String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  shifts       CashShift[]

  @@map("NguoiDung")
}

// 1.1. PHÂN QUYỀN & VAI TRÒ HỆ THỐNG (RBAC)
model RolePermission {
  id          String   @id @default(uuid())
  roleKey     String   @unique
  roleNameVi  String
  description String?  @db.NVarChar(Max)
  badgeColor  String?
  gradient    String?
  defaultTab  String?  @default("pos")
  permissions String   @db.NVarChar(Max)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("PhanQuyenVaiTro")
}

model SystemModule {
  id          String   @id
  label       String
  category    String
  description String?  @db.NVarChar(Max)
  orderIndex  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("DanhMucPhanHe")
}

// 2. SẢN PHẨM & ĐƠN VỊ TÍNH QUY ĐỔI (MULTI-UOM)
model Product {
  id              String                 @id @default(uuid())
  sku             String                 @unique
  barcode         String                 @default("")
  name            String
  category        String
  unit            String                 // ĐVT cơ bản (base unit)
  costPrice       Decimal                @db.Decimal(18, 2)
  sellingPrice    Decimal                @db.Decimal(18, 2)
  stock           Decimal                @db.Decimal(18, 2)
  minStock        Decimal                @default(5) @db.Decimal(18, 2)
  image           String?
  warehouse       String                 @default("Kho Chính")
  storageLocation String?
  description     String?                @db.NVarChar(Max)
  isFeatured      Boolean                @default(false)
  weightOrVolume  String?
  specifications  String?                @db.NVarChar(Max)
  color           String?
  brand           String?
  warrantyMonths  Int?                   @default(12)
  accessories     String?                @db.NVarChar(Max)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  uomConversions  ProductUOMConversion[]
  orderItems      OrderItem[]
  receiptItems    StockGoodsReceiptItem[]
  inventoryLogs   InventoryLog[]

  @@map("SanPham")
}

model ProductUOMConversion {
  id             String   @id @default(uuid())
  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  unit           String   // 'Thùng', 'Cuộn', 'Mét', 'Kg', 'Hộp'...
  ratioToBase    Decimal  @db.Decimal(18, 4) // Hệ số nhân để quy ra đơn vị cơ bản
  costPrice      Decimal  @db.Decimal(18, 2)
  sellingPrice   Decimal  @db.Decimal(18, 2)
  barcode        String?
  isBase         Boolean  @default(false)
  referenceUnit  String?
  conversionRate Decimal? @db.Decimal(18, 4)
  description    String?

  @@map("QuyDoiDonViTinh")
}

// 3. KHÁCH HÀNG & CRM
model Customer {
  id          String   @id @default(uuid())
  name        String
  phone       String   @unique
  email       String?
  address     String?
  tier        String   @default("Đồng") // 'Đồng' | 'Bạc' | 'Vàng' | 'Kim Cương'
  points      Decimal  @default(0) @db.Decimal(18, 2)
  totalSpent  Decimal  @default(0) @db.Decimal(18, 2)
  totalOrders Int      @default(0)
  debt        Decimal  @default(0) @db.Decimal(18, 2)
  note        String?  @db.NVarChar(Max)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  orders      Order[]

  @@map("KhachHang")
}

// 4. BÁN HÀNG POS & ĐƠN HÀNG
model Order {
  id              String      @id @default(uuid())
  code            String      @unique // e.g. DH-10029
  channel         String      @default("Tại quầy (POS)")
  status          String      @default("completed") // 'pending'|'confirmed'|'processing'|'shipping'|'completed'|'cancelled'|'refunded'
  customerId      String?
  customer        Customer?   @relation(fields: [customerId], references: [id])
  customerName    String?
  customerPhone   String?
  customerAddress String?
  customerRank    String?
  subtotal        Decimal     @db.Decimal(18, 2)
  discountAmount  Decimal     @default(0) @db.Decimal(18, 2)
  discountCode    String?
  taxRate         Decimal     @default(0) @db.Decimal(5, 2)
  taxAmount       Decimal     @default(0) @db.Decimal(18, 2)
  shippingFee     Decimal     @default(0) @db.Decimal(18, 2)
  shippingPartner String?
  trackingCode    String?
  total           Decimal     @db.Decimal(18, 2)
  totalCost       Decimal     @default(0) @db.Decimal(18, 2)
  profit          Decimal     @default(0) @db.Decimal(18, 2)
  paymentMethod   String      @default("cash") // 'cash'|'transfer'|'card'|'momo'|'debt'
  paymentStatus   String      @default("paid") // 'paid'|'unpaid'|'partial'
  paidAmount      Decimal     @db.Decimal(18, 2)
  changeAmount    Decimal     @default(0) @db.Decimal(18, 2)
  note            String?     @db.NVarChar(Max)
  shiftId         String?
  createdAt       DateTime    @default(now())
  completedAt     DateTime?
  items           OrderItem[]
  eInvoices       EInvoice[]

  @@map("HoaDon")
}

model OrderItem {
  id              String   @id @default(uuid())
  orderId         String
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId       String
  product         Product  @relation(fields: [productId], references: [id])
  productName     String
  sku             String
  unit            String
  ratioToBase     Decimal  @default(1) @db.Decimal(18, 4)
  quantity        Decimal  @db.Decimal(18, 2)
  unitPrice       Decimal  @db.Decimal(18, 2)
  costPrice       Decimal  @db.Decimal(18, 2)
  discountPercent Decimal  @default(0) @db.Decimal(5, 2)
  total           Decimal  @db.Decimal(18, 2)

  @@map("ChiTietHoaDon")
}

// 5. CA LÀM VIỆC THU NGÂN
model CashShift {
  id                 String    @id @default(uuid())
  shiftName          String
  staffId            String?
  user               User?     @relation(fields: [staffId], references: [id])
  staffName          String
  startTime          DateTime  @default(now())
  endTime            DateTime?
  initialCash        Decimal   @db.Decimal(18, 2)
  cashSales          Decimal   @default(0) @db.Decimal(18, 2)
  transferSales      Decimal   @default(0) @db.Decimal(18, 2)
  cardSales          Decimal   @default(0) @db.Decimal(18, 2)
  otherSales         Decimal   @default(0) @db.Decimal(18, 2)
  totalSales         Decimal   @default(0) @db.Decimal(18, 2)
  cashWithdrawals    Decimal   @default(0) @db.Decimal(18, 2)
  expectedEndingCash Decimal   @default(0) @db.Decimal(18, 2)
  actualEndingCash   Decimal?  @db.Decimal(18, 2)
  note               String?   @db.NVarChar(Max)
  status             String    @default("open") // 'open' | 'closed'

  @@map("CaBanHang")
}

// 6. NHẬT KÝ KHO & PHIẾU NHẬP KHO
model InventoryLog {
  id             String   @id @default(uuid())
  productId      String
  product        Product  @relation(fields: [productId], references: [id])
  productName    String
  sku            String
  type           String   // 'import' | 'export' | 'audit_adjustment' | 'sale_deduct'
  quantityChange Decimal  @db.Decimal(18, 2)
  oldStock       Decimal  @db.Decimal(18, 2)
  newStock       Decimal  @db.Decimal(18, 2)
  unitPrice      Decimal? @db.Decimal(18, 2)
  reason         String   @db.NVarChar(Max)
  performedBy    String
  timestamp      DateTime @default(now())

  @@map("NhatKyKho")
}

model StockGoodsReceipt {
  id                 String                  @id @default(uuid())
  code               String                  @unique // e.g. PNK-2026-0816-001
  date               DateTime                @default(now())
  sourceType         String?                 @default("manual") // 'po' | 'quote' | 'inbound_invoice' | 'manual'
  sourceId           String?
  sourceCode         String?
  inboundInvoiceId   String?
  inboundInvoiceCode String?
  supplierName       String
  supplierTaxCode    String?
  supplierPhone      String?
  supplierAddress    String?
  warehouseName      String                  @default("Kho Chính")
  creatorName        String
  receivedBy         String
  totalItemsCount    Int
  totalQuantity      Decimal                 @db.Decimal(18, 2)
  totalCostAmount    Decimal                 @db.Decimal(18, 2)
  totalTaxAmount     Decimal                 @default(0) @db.Decimal(18, 2)
  grandTotal         Decimal                 @db.Decimal(18, 2)
  paymentStatus      String                  @default("paid") // 'paid' | 'debt_pending' | 'partial'
  notes              String?                 @db.NVarChar(Max)
  items              StockGoodsReceiptItem[]

  @@map("PhieuNhapKho")
}

model StockGoodsReceiptItem {
  id              String            @id @default(uuid())
  receiptId       String
  receipt         StockGoodsReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  productId       String
  product         Product           @relation(fields: [productId], references: [id])
  productName     String
  sku             String
  unit            String
  quantity        Decimal           @db.Decimal(18, 2)
  oldStock        Decimal           @db.Decimal(18, 2)
  newStock        Decimal           @db.Decimal(18, 2)
  oldCostPrice    Decimal           @db.Decimal(18, 2)
  newCostPrice    Decimal           @db.Decimal(18, 2)
  unitCost        Decimal           @db.Decimal(18, 2)
  taxRate         Decimal           @default(0) @db.Decimal(5, 2)
  totalAmount     Decimal           @db.Decimal(18, 2)
  storageLocation String?
  warehouse       String?
  category        String?
  specifications  String?           @db.NVarChar(Max)
  color           String?
  brand           String?
  warrantyMonths  Int?              @default(12)
  accessories     String?           @db.NVarChar(Max)
  serials         String?           @db.NVarChar(Max)
  notes           String?

  @@map("ChiTietPhieuNhapKho")
}

// 6.1 PHIẾU XUẤT KHO (STOCK GOODS ISSUE / OUTBOUND NOTE)
model StockGoodsIssue {
  id              String                @id @default(uuid())
  code            String                @unique // e.g. XK-2026-0001
  orderId         String?
  orderCode       String                // DH-10029
  customerName    String
  customerPhone   String?
  customerAddress String?
  warehouseName   String                @default("Kho Chính")
  dispatchedBy    String
  dispatchedAt    DateTime              @default(now())
  totalQuantity   Decimal               @db.Decimal(18, 2)
  totalItemsCount Int                   @default(1)
  status          String                @default("completed") // 'completed' | 'cancelled'
  notes           String?               @db.NVarChar(Max)
  createdAt       DateTime              @default(now())
  items           StockGoodsIssueItem[]

  @@map("PhieuXuatKho")
}

model StockGoodsIssueItem {
  id             String          @id @default(uuid())
  issueId        String
  issue          StockGoodsIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  productId      String
  productName    String
  sku            String
  unit           String          @default("Cái")
  quantity       Decimal         @db.Decimal(18, 2)
  serials        String?         @db.NVarChar(Max) // JSON array of serial strings
  warrantyMonths Int?            @default(12)
  notes          String?

  @@map("ChiTietPhieuXuatKho")
}

// 7. BÁO GIÁ (PRICE QUOTES)
model PriceQuote {
  id              String           @id @default(uuid())
  code            String           @unique // BG-2026-001
  customerName    String
  customerPhone   String
  customerCompany String?
  totalAmount     Decimal          @db.Decimal(18, 2)
  discountPercent Decimal          @default(0) @db.Decimal(5, 2)
  finalTotal      Decimal          @db.Decimal(18, 2)
  validUntil      DateTime
  status          String           @default("draft") // 'draft'|'sent'|'approved'|'converted_to_order'|'completed'|'rejected'
  createdAt       DateTime         @default(now())
  notes           String?          @db.NVarChar(Max)
  items           PriceQuoteItem[]

  @@map("BaoGia")
}

model PriceQuoteItem {
  id          String     @id @default(uuid())
  quoteId     String
  quote       PriceQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  productName String
  sku         String
  unit        String
  quantity    Decimal    @db.Decimal(18, 2)
  unitPrice   Decimal    @db.Decimal(18, 2)
  total       Decimal    @db.Decimal(18, 2)

  @@map("ChiTietBaoGia")
}

// 8. ĐỊNH MỨC BOM & TÍNH GIÁ THÀNH
model ProductCosting {
  id                       String          @id @default(uuid())
  productName              String
  sku                      String          @unique
  rawMaterialsCost         Decimal         @db.Decimal(18, 2)
  laborCost                Decimal         @db.Decimal(18, 2)
  machineryAndOverheadCost Decimal         @db.Decimal(18, 2)
  totalStandardCost        Decimal         @db.Decimal(18, 2)
  currentSellingPrice      Decimal         @db.Decimal(18, 2)
  grossMarginPercent       Decimal         @db.Decimal(5, 2)
  lastUpdated              DateTime        @default(now())
  bomItems                 CostingBOMItem[]

  @@map("DinhMucSanXuat")
}

model CostingBOMItem {
  id           String         @id @default(uuid())
  costingId    String
  costing      ProductCosting @relation(fields: [costingId], references: [id], onDelete: Cascade)
  materialName String
  quantity     Decimal        @db.Decimal(18, 2)
  unit         String
  unitCost     Decimal        @db.Decimal(18, 2)
  totalCost    Decimal        @db.Decimal(18, 2)

  @@map("ChiTietDinhMucBOM")
}

// 9. TÀI SẢN DOANH NGHIỆP
model EnterpriseAsset {
  id                  String    @id @default(uuid())
  code                String    @unique // TS-001
  name                String
  category            String
  purchaseDate        DateTime
  originalValue       Decimal   @db.Decimal(18, 2)
  depreciationMonths  Int
  remainingValue      Decimal   @db.Decimal(18, 2)
  assignedTo          String
  status              String    @default("good") // 'good'|'maintenance_required'|'broken'|'liquidated'
  lastMaintenanceDate DateTime?

  @@map("TaiSanDoanhNghiep")
}

// 10. BẢO HÀNH & SERIAL/IMEI
model WarrantyTicket {
  id                      String                  @id @default(uuid())
  code                    String                  @unique // BH-2026-001
  type                    String                  @default("warranty") // 'warranty'|'maintenance'|'repair'
  priority                String                  @default("normal") // 'low'|'normal'|'high'|'urgent'
  status                  String                  @default("received") // 'received'|'diagnosing'|'repairing'|'waiting_parts'|'sent_vendor'|'ready_to_return'|'returned'|'replaced_new'|'unrepairable'
  orderCode               String?
  productId               String?
  productName             String
  model                   String?
  serialNumber            String
  qrCodeUrl               String?
  customerName            String
  customerPhone           String
  customerAddress         String?
  customerEmail           String?
  accessoriesIncluded     String?
  cosmeticCondition       String?
  issueDescription        String                  @db.NVarChar(Max)
  technicianDiagnosis     String?                 @db.NVarChar(Max)
  resolution              String?                 @db.NVarChar(Max)
  technicianName          String
  receivedDate            DateTime                @default(now())
  expectedReturnDate      DateTime
  actualReturnDate        DateTime?
  laborCost               Decimal                 @default(0) @db.Decimal(18, 2)
  partsCost               Decimal                 @default(0) @db.Decimal(18, 2)
  discountAmount          Decimal                 @default(0) @db.Decimal(18, 2)
  totalFee                Decimal                 @default(0) @db.Decimal(18, 2)
  paymentStatus           String                  @default("free") // 'free'|'paid'|'unpaid'|'partial'
  paidAmount              Decimal                 @default(0) @db.Decimal(18, 2)
  returnedToPerson        String?
  returnNote              String?                 @db.NVarChar(Max)
  warrantyExtensionMonths Int                     @default(0)
  parts                   WarrantyPartItem[]
  timeline                WarrantyTimelineEvent[]

  @@map("PhieuBaoHanh")
}

model WarrantyPartItem {
  id              String         @id @default(uuid())
  warrantyId      String
  warranty        WarrantyTicket @relation(fields: [warrantyId], references: [id], onDelete: Cascade)
  partName        String
  sku             String?
  quantity        Decimal        @db.Decimal(18, 2)
  unit            String
  unitPrice       Decimal        @db.Decimal(18, 2)
  isUnderWarranty Boolean        @default(true)
  warrantyMonths  Int            @default(0)

  @@map("LinhKienBaoHanh")
}

model WarrantyTimelineEvent {
  id         String         @id @default(uuid())
  warrantyId String
  warranty   WarrantyTicket @relation(fields: [warrantyId], references: [id], onDelete: Cascade)
  timestamp  DateTime       @default(now())
  action     String
  actor      String
  notes      String?        @db.NVarChar(Max)
  status     String

  @@map("NhatKyBaoHanh")
}

model SerialDeviceRecord {
  id                     String    @id @default(uuid())
  serialNumber           String    @unique
  productId              String?
  productName            String
  sku                    String
  brand                  String?
  color                  String?
  specifications         String?   @db.NVarChar(Max)
  accessories            String?   @db.NVarChar(Max)
  status                 String    @default("in_stock") // 'in_stock' | 'reserved' | 'sold' | 'under_warranty' | 'defective' | 'returned_to_vendor'
  warehouseName          String?   @default("Kho Chính")
  storageLocation        String?
  receiptCode            String?
  receiptDate            DateTime?
  soldOrderCode          String?
  soldDate               DateTime?
  customerName           String?
  customerPhone          String?
  customerAddress        String?
  warrantyPeriodMonths   Int       @default(12)
  warrantyExpiryDate     DateTime?
  warrantyStatus         String    @default("valid") // 'valid' | 'expired' | 'voided'
  totalRepairsCount      Int       @default(0)
  totalMaintenancesCount Int       @default(0)
  notes                  String?   @db.NVarChar(Max)

  @@map("SoSerialThietBi")
}

// 11. HÓA ĐƠN ĐIỆN TỬ (TT78) & ĐẦU VÀO XML
model EInvoice {
  id               String         @id @default(uuid())
  invoiceCode      String         @unique // 1C26TGP-00000088
  invoiceNumber    String
  invoiceSymbol    String         // 1C26TGP
  invoiceTemplate  String         // 1/001
  invoiceType      String         @default("vat") // 'vat' | 'sales'
  cqtCode          String?
  lookupCode       String         @unique
  lookupUrl        String
  issueDate        DateTime       @default(now())
  signDate         DateTime?
  status           String         @default("draft") // 'draft'|'signed'|'sent_cqt'|'cqt_approved'|'cancelled'|'adjusted'
  orderId          String?
  order            Order?         @relation(fields: [orderId], references: [id])
  orderCode        String?
  sellerData       String         @db.NVarChar(Max) // JSON
  buyerData        String         @db.NVarChar(Max) // JSON
  subtotal         Decimal        @db.Decimal(18, 2)
  discountAmount   Decimal        @default(0) @db.Decimal(18, 2)
  taxRate          Decimal        @db.Decimal(5, 2)
  taxAmount        Decimal        @db.Decimal(18, 2)
  totalAmount      Decimal        @db.Decimal(18, 2)
  amountInWords    String
  paymentMethod    String         @default("TM/CK")
  notes            String?        @db.NVarChar(Max)
  digitalSignature String?        @db.NVarChar(Max) // JSON
  cqtStatusMessage String?
  items            EInvoiceItem[]

  @@map("HoaDonDienTu")
}

model EInvoiceItem {
  id              String   @id @default(uuid())
  invoiceId       String
  invoice         EInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  sku             String
  productName     String
  unit            String
  quantity        Decimal  @db.Decimal(18, 2)
  unitPrice       Decimal  @db.Decimal(18, 2)
  subtotal        Decimal  @db.Decimal(18, 2)
  discountPercent Decimal  @default(0) @db.Decimal(5, 2)
  discountAmount  Decimal  @default(0) @db.Decimal(18, 2)
  taxRate         Decimal  @db.Decimal(5, 2)
  taxAmount       Decimal  @db.Decimal(18, 2)
  total           Decimal  @db.Decimal(18, 2)

  @@map("ChiTietHoaDonDienTu")
}

model InboundEInvoice {
  id                 String               @id @default(uuid())
  source             String               @default("xml_upload") // 'cqt_portal'|'gmail_sync'|'xml_upload'
  sourceDetail       String?
  sourceFile         String?
  invoiceCode        String               @unique
  invoiceNumber      String
  invoiceSymbol      String
  invoiceTemplate    String
  issueDate          DateTime
  receivedDate       DateTime             @default(now())
  cqtCode            String?
  lookupCode         String?
  lookupUrl          String?
  sellerData         String               @db.NVarChar(Max) // JSON
  buyerData          String               @db.NVarChar(Max) // JSON
  subtotal           Decimal              @db.Decimal(18, 2)
  taxRate            Decimal              @db.Decimal(5, 2)
  taxAmount          Decimal              @db.Decimal(18, 2)
  totalAmount        Decimal              @db.Decimal(18, 2)
  amountInWords      String
  status             String               @default("pending_review") // 'pending_review'|'matched'|'imported_to_stock'|'rejected'
  goodsReceiptId     String?
  importedAt         DateTime?
  importedBy         String?
  targetWarehouse    String?
  accountingRecordId String?
  notes              String?              @db.NVarChar(Max)
  rawXmlContent      String?              @db.NVarChar(Max)
  items              InboundInvoiceItem[]

  @@map("HoaDonDauVao")
}

model InboundInvoiceItem {
  id                      String          @id @default(uuid())
  inboundInvoiceId        String
  inboundInvoice          InboundEInvoice @relation(fields: [inboundInvoiceId], references: [id], onDelete: Cascade)
  lineNumber              Int
  productName             String
  skuOrCode               String?
  unit                    String
  quantity                Decimal         @db.Decimal(18, 2)
  unitPrice               Decimal         @db.Decimal(18, 2)
  subtotal                Decimal         @db.Decimal(18, 2)
  taxRate                 Decimal         @db.Decimal(5, 2)
  taxAmount               Decimal         @db.Decimal(18, 2)
  total                   Decimal         @db.Decimal(18, 2)
  matchedProductId        String?
  matchedProductName      String?
  matchedProductSku       String?
  currentStock            Decimal?        @db.Decimal(18, 2)
  currentCostPrice        Decimal?        @db.Decimal(18, 2)
  ratioToBaseUnit         Decimal         @default(1) @db.Decimal(18, 4)
  isNewProduct            Boolean         @default(false)
  status                  String          @default("unmatched") // 'matched'|'unmatched'|'needs_create'|'ignored'
  assignedCategory        String?
  assignedWarehouse       String?
  assignedStorageLocation String?
  suggestedSellingPrice   Decimal?        @db.Decimal(18, 2)
  customSku               String?
  customBarcode           String?

  @@map("ChiTietHoaDonDauVao")
}

// 12. HỢP ĐỒNG LAO ĐỘNG & NHÂN SỰ HR
model LaborContract {
  id             String   @id @default(uuid())
  contractNumber String   @unique // HĐLĐ-2026/GP-001
  employeeId     String
  employeeCode   String
  employeeName   String
  employeeRole   String
  contractType   String
  startDate      DateTime
  endDate        DateTime?
  signDate       DateTime @default(now())
  status         String   @default("active") // 'draft'|'sent_for_signature'|'signed'|'active'|'expired'|'terminated'
  employerData   String   @db.NVarChar(Max) // JSON
  employeeInfo   String   @db.NVarChar(Max) // JSON
  termsData      String   @db.NVarChar(Max) // JSON
  signaturesData String   @db.NVarChar(Max) // JSON
  notes          String?  @db.NVarChar(Max)

  @@map("HopDongLaoDong")
}

model Employee {
  id             String   @id @default(uuid())
  code           String   @unique
  name           String
  role           String   // 'Thu Ngân' | 'Thủ Kho' | 'Kế Toán' | 'Quản Lý Cửa Hàng' | 'Nhân Viên Bán Hàng'
  phone          String
  email          String
  baseSalary     Decimal  @db.Decimal(18, 2)
  salesKpiTarget Decimal  @default(0) @db.Decimal(18, 2)
  currentSales   Decimal  @default(0) @db.Decimal(18, 2)
  commissionRate Decimal  @default(0) @db.Decimal(5, 2) // %
  status         String   @default("active") // 'active' | 'leave' | 'inactive'
  avatar         String?
  joinedDate     DateTime @default(now())
  shiftSchedule  String?

  @@map("NhanVien")
}

// 13. KẾ TOÁN, KHUYẾN MÃI, CẢNH BÁO FRAUD & CÀI ĐẶT
model AccountingRecord {
  id            String   @id @default(uuid())
  code          String   @unique
  type          String   // 'income' | 'expense'
  category      String   // 'Bán hàng'|'Nhập hàng'|'Chi lương nhân viên'|'Thuế VAT'|'Mặt bằng & Điện nước'|'Thu nợ khách'|'Khác'
  amount        Decimal  @db.Decimal(18, 2)
  date          DateTime @default(now())
  party         String   // Đối tác / Khách hàng / NCC
  paymentMethod String   @default("cash")
  status        String   @default("completed")
  note          String?  @db.NVarChar(Max)
  receiptNumber String?

  @@map("SoThuChiKeToan")
}

model Promotion {
  id            String   @id @default(uuid())
  code          String   @unique
  title         String
  discountType  String   // 'percentage' | 'fixed'
  discountValue Decimal  @db.Decimal(18, 2)
  minOrderValue Decimal  @default(0) @db.Decimal(18, 2)
  maxDiscount   Decimal? @db.Decimal(18, 2)
  usageLimit    Int      @default(100)
  usedCount     Int      @default(0)
  startDate     DateTime
  endDate       DateTime
  isActive      Boolean  @default(true)

  @@map("ChuongTrinhKhuyenMai")
}

model FraudAlert {
  id              String   @id @default(uuid())
  severity        String   // 'high' | 'medium' | 'low'
  title           String
  description     String   @db.NVarChar(Max)
  timestamp       DateTime @default(now())
  source          String   // 'POS' | 'CashShift' | 'Inventory' | 'Accounting'
  status          String   @default("unresolved") // 'unresolved' | 'investigating' | 'resolved'
  suggestedAction String   @db.NVarChar(Max)

  @@map("CanhBaoGianLan")
}

model StoreSettings {
  id           String   @id @default("default_settings")
  storeName    String   @default("GP-ERP Enterprise")
  tagline      String?
  phone        String?
  email        String?
  address      String?
  taxCode      String?
  bankName     String?
  bankAccount  String?
  bankCode     String?
  settingsJson String   @db.NVarChar(Max) // Lưu toàn bộ JSON cấu hình mở rộng (in ấn, máy in, scanner, ...)
  updatedAt    DateTime @updatedAt

  @@map("CauHinhCuaHang")
}

// 14. NHÀ CUNG CẤP & BẢNG GIÁ ĐỐI TÁC
model Supplier {
  id             String               @id @default(uuid())
  code           String               @unique // NCC-001
  name           String
  taxCode        String?
  tier           String               @default("Tổng Đại Lý") // 'Tier 1 Chính Hãng' | 'Tổng Đại Lý' | 'Nhà Phân Phối'
  category       String               @default("Camera & An Ninh")
  contactPerson  String?
  phone          String
  email          String?
  address        String?
  bankName       String?
  bankAccount    String?
  bankCode       String?
  creditLimit    Decimal              @default(0) @db.Decimal(18, 2)
  creditDays     Int                  @default(30)
  currentDebt    Decimal              @default(0) @db.Decimal(18, 2)
  ratingQuality  Decimal              @default(9.5) @db.Decimal(4, 2)
  ratingPrice    Decimal              @default(9.0) @db.Decimal(4, 2)
  ratingOnTime   Decimal              @default(9.5) @db.Decimal(4, 2)
  ratingWarranty Decimal              @default(9.2) @db.Decimal(4, 2)
  notes          String?              @db.NVarChar(Max)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  priceList      SupplierPriceItem[]
  purchaseOrders PurchaseOrder[]

  @@map("NhaCungCap")
}

model SupplierPriceItem {
  id             String   @id @default(uuid())
  supplierId     String
  supplier       Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  sku            String
  productName    String
  costPrice      Decimal  @db.Decimal(18, 2)
  warrantyMonths Int      @default(24)
  moq            Int      @default(1)

  @@map("BangGiaNhaCungCap")
}

// 15. ĐƠN ĐẶT HÀNG MUA (PURCHASE ORDERS - PO)
model PurchaseOrder {
  id                   String              @id @default(uuid())
  code                 String              @unique // PO-2026-0001
  supplierId           String
  supplier             Supplier            @relation(fields: [supplierId], references: [id])
  supplierName         String
  supplierPhone        String?
  supplierAddress      String?
  supplierTaxCode      String?
  warehouseId          String              @default("wh-main")
  warehouseName        String              @default("Kho Chính")
  orderDate            DateTime            @default(now())
  expectedDeliveryDate DateTime
  status               String              @default("confirmed") // 'draft'|'sent'|'confirmed'|'partially_received'|'completed'|'cancelled'
  subtotal             Decimal             @db.Decimal(18, 2)
  vatRate              Decimal             @default(10) @db.Decimal(5, 2)
  vatAmount            Decimal             @default(0) @db.Decimal(18, 2)
  shippingFee          Decimal             @default(0) @db.Decimal(18, 2)
  discountAmount       Decimal             @default(0) @db.Decimal(18, 2)
  totalAmount          Decimal             @db.Decimal(18, 2)
  paidAmount           Decimal             @default(0) @db.Decimal(18, 2)
  paymentStatus        String              @default("unpaid") // 'unpaid'|'partial'|'paid'
  paymentMethod        String              @default("transfer")
  notes                String?             @db.NVarChar(Max)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  items                PurchaseOrderItem[]

  @@map("DonDatHangMua")
}

model PurchaseOrderItem {
  id              String        @id @default(uuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId       String?
  sku             String
  productName     String
  unit            String        @default("Cái")
  quantity        Decimal       @db.Decimal(18, 2)
  unitPrice       Decimal       @db.Decimal(18, 2)
  total           Decimal       @db.Decimal(18, 2)

  @@map("ChiTietDonDatHangMua")
}

// 16. PHIẾU TRẢ HÀNG & HOÀN TIỀN (CUSTOMER RETURN & SUPPLIER RMA)
model ReturnOrder {
  id                  String            @id @default(uuid())
  code                String            @unique // e.g. TH-2026-0001
  type                String            @default("customer_return") // 'customer_return' | 'supplier_return'
  originalOrderCode   String?
  originalOrderId     String?
  customerId          String?
  customerName        String?
  customerPhone       String?
  supplierId          String?
  supplierName        String?
  warehouse           String            @default("Kho Chính")
  refundMethod        String            @default("cash") // 'cash' | 'transfer' | 'debt_deduct' | 'no_refund'
  refundAmount        Decimal           @db.Decimal(18, 2)
  totalReturnQuantity Decimal           @db.Decimal(18, 2)
  reason              String            // 'defective' | 'customer_mind_change' | 'wrong_item' | 'warranty_exchange' | 'other'
  destinationType     String            @default("restock") // 'restock' | 'faulty_warehouse' | 'supplier_rma'
  status              String            @default("completed") // 'pending' | 'completed' | 'cancelled'
  performedBy         String
  notes               String?           @db.NVarChar(Max)
  createdAt           DateTime          @default(now())
  items               ReturnOrderItem[]

  @@map("PhieuTraHang")
}

model ReturnOrderItem {
  id              String      @id @default(uuid())
  returnOrderId   String
  returnOrder     ReturnOrder @relation(fields: [returnOrderId], references: [id], onDelete: Cascade)
  productId       String
  productName     String
  sku             String
  unit            String
  ratioToBase     Decimal     @default(1) @db.Decimal(18, 4)
  quantity        Decimal     @db.Decimal(18, 2)
  unitPrice       Decimal     @db.Decimal(18, 2)
  refundUnitPrice Decimal     @db.Decimal(18, 2)
  totalRefund     Decimal     @db.Decimal(18, 2)
  serialNumber    String?
  condition       String      @default("normal") // 'normal' | 'damaged' | 'unopened'

  @@map("ChiTietPhieuTraHang")
}

// 17. CHUYỂN KHO NỘI BỘ (INTER-BRANCH STOCK TRANSFERS)
model StockTransfer {
  id              String              @id @default(uuid())
  code            String              @unique // e.g. CK-2026-0001
  fromWarehouse   String
  toWarehouse     String
  transferDate    DateTime            @default(now())
  receivedDate    DateTime?
  status          String              @default("in_transit") // 'draft' | 'in_transit' | 'completed' | 'cancelled'
  totalItems      Int
  totalQuantity   Decimal             @db.Decimal(18, 2)
  senderName      String
  receiverName    String?
  transportMethod String?
  trackingNumber  String?
  notes           String?             @db.NVarChar(Max)
  createdAt       DateTime            @default(now())
  items           StockTransferItem[]

  @@map("PhieuDieuChuyenKho")
}

model StockTransferItem {
  id            String        @id @default(uuid())
  transferId    String
  transfer      StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  productId     String
  productName   String
  sku           String
  unit          String
  quantity      Decimal       @db.Decimal(18, 2)
  unitCost      Decimal       @db.Decimal(18, 2)
  totalCost     Decimal       @db.Decimal(18, 2)

  @@map("ChiTietDieuChuyenKho")
}

// ==========================================
// 18. DỮ LIỆU CƠ BẢN & MDM (MASTER DATA MANAGEMENT)
// ==========================================

// 18.1 PHÒNG BAN & BỘ PHẬN
model Department {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  managerName String?
  budget      Decimal  @default(0) @db.Decimal(18, 2)
  memberCount Int      @default(0)
  status      String   @default("active") // 'active' | 'inactive'
  description String?  @db.NVarChar(Max)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("PhongBan")
}

// 18.2 CHỨC VỤ & CẤP BẬC
model JobPosition {
  id                      String   @id @default(uuid())
  code                    String   @unique
  title                   String
  departmentId            String?
  departmentName          String?
  baseSalary              Decimal  @default(0) @db.Decimal(18, 2)
  responsibilityAllowance Decimal  @default(0) @db.Decimal(18, 2)
  status                  String   @default("active") // 'active' | 'inactive'
  description             String?  @db.NVarChar(Max)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@map("ChucVu")
}

// 18.3 VỊ TRÍ LƯU KHO & Ô KỆ
model WarehouseLocation {
  id            String   @id @default(uuid())
  code          String   @unique
  name          String
  warehouseName String   @default("Kho Tổng")
  zone          String?
  shelf         String?
  tier          String?
  bin           String?
  capacity      Int      @default(100)
  currentUsage  Int      @default(0)
  status        String   @default("active") // 'active' | 'maintenance' | 'full'
  notes         String?  @db.NVarChar(Max)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("ViTriLuuKho")
}

// 18.4 ĐƠN VỊ TÍNH CHUẨN
model MasterUnitOfMeasure {
  id               String   @id @default(uuid())
  code             String   @unique
  name             String
  symbol           String?
  isBaseUnit       Boolean  @default(true)
  referenceUnit    String?
  conversionFactor Decimal? @db.Decimal(18, 4)
  status           String   @default("active") // 'active' | 'inactive'
  description      String?  @db.NVarChar(Max)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("DanhMucDonViTinh")
}

// 18.4.1 BẢNG QUY ĐỔI ĐƠN VỊ TÍNH (1 ĐVT A = Hệ Số x ĐVT B)
model MasterUOMConversion {
  id           String   @id @default(uuid())
  fromUnitName String   // VD: 'Thùng', 'Cuộn', 'Hộp', 'Pallet'
  fromUnitId   String?
  factor       Decimal  @db.Decimal(18, 4) // VD: 10, 100, 24
  toUnitName   String   // VD: 'Cuộn', 'Mét', 'Kg', 'Lon', 'Cái'
  toUnitId     String?
  note         String?  // VD: '1 Thùng = 10 Cuộn', '1 Cuộn = 100m (~10kg)'
  status       String   @default("active") // 'active' | 'inactive'
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("DanhMucQuyDoiDVT")
}

// 18.5 DANH MỤC NGÀNH HÀNG MASTER
model MasterProductCategory {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  slug        String?
  icon        String?
  parentId    String?
  sortOrder   Int      @default(0)
  status      String   @default("active") // 'active' | 'inactive'
  description String?  @db.NVarChar(Max)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("DanhMucNganhHang")
}

// 18.6 NHÓM KHÁCH HÀNG
model CustomerGroup {
  id              String   @id @default(uuid())
  code            String   @unique
  name            String
  discountPercent Decimal  @default(0) @db.Decimal(5, 2)
  paymentTerms    String   @default("Thanh toán ngay")
  creditLimit     Decimal  @default(0) @db.Decimal(18, 2)
  description     String?  @db.NVarChar(Max)
  customerCount   Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("NhomKhachHang")
}

// 18.7 HẠNG THÀNH VIÊN KHÁCH HÀNG
model MasterCustomerTier {
  id              String   @id @default(uuid())
  code            String   @unique
  name            String
  minSpend        Decimal  @default(0) @db.Decimal(18, 2)
  discountPercent Decimal  @default(0) @db.Decimal(5, 2)
  pointMultiplier Decimal  @default(1.0) @db.Decimal(5, 2)
  color           String?  @default("#10B981")
  badge           String?
  benefits        String?  @db.NVarChar(Max)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("HangThanhVien")
}

// 18.8 PHÂN LOẠI NHÀ CUNG ỨNG
model MasterSupplierCategory {
  id                  String   @id @default(uuid())
  code                String   @unique
  name                String
  description         String?  @db.NVarChar(Max)
  defaultPaymentTerms String   @default("Gối đầu 30 ngày")
  supplierCount       Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("PhanLoaiNhaCungCap")
}

// 18.9 DỰ ÁN DOANH NGHIỆP & CÔNG TRÌNH
model EnterpriseProject {
  id                String   @id @default(uuid())
  code              String   @unique
  name              String
  status            String   @default("in_progress") // 'in_progress' | 'completed' | 'planning' | 'on_hold'
  customerName      String
  customerId        String?
  managerName       String
  managerId         String?
  budget            Decimal  @default(0) @db.Decimal(18, 2)
  startDate         String
  endDate           String?
  sector            String   @default("Công Nghệ Thông Tin & Phần Mềm")
  description       String?  @db.NVarChar(Max)
  linkedDeviceCount Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("DuAnDoanhNghiep")
}

// 18.10 CẤU HÌNH CỔNG EMAIL & MẪU EMAIL
model EmailGatewayConfig {
  id                     String    @id @default(uuid())
  smtpHost               String    @default("smtp.gmail.com")
  smtpPort               Int       @default(587)
  secure                 Boolean   @default(false)
  authUser               String    @default("hethonggiaphuc@gmail.com")
  authPasswordMasked     String    @default("••••••••••••••••")
  defaultSenderName      String    @default("GIA PHÚC Computer - Hệ Thống GPSOFT")
  defaultSenderEmail     String    @default("no-reply@vitinhgiaphuc.com")
  adminNotificationEmail String    @default("hrmgpsoft@gmail.com")
  accountingEmail        String    @default("ketoan@vitinhgiaphuc.com")
  salesEmail             String    @default("sales@vitinhgiaphuc.com")
  signatureHtml          String?   @db.NVarChar(Max)
  isGatewayActive        Boolean   @default(true)
  lastTestSuccessAt      DateTime?
  updatedAt              DateTime  @updatedAt

  @@map("CauHinhEmail")
}

model EmailTemplate {
  id           String   @id @default(uuid())
  templateType String   @unique // 'einvoice_vat' | 'quote_proposal' | 'purchase_order' | 'password_reset_request' | 'password_reset_approved'
  name         String
  subject      String
  bodyHtml     String   @db.NVarChar(Max)
  variables    String?  @db.NVarChar(Max)
  updatedAt    DateTime @updatedAt

  @@map("MauEmail")
}
