  customerName   String?
  customerPhone  String?
  warehouseName  String?
  notes          String?  @db.NVarChar(Max)
  performedBy    String
  timestamp      DateTime @default(now())

  @@index([serialNumber])
  @@index([timestamp])
  @@map("NhatKySerialThietBi")
}

// 17. CHUYỂN KHO NỘI BỘ (INTER-BRANCH STOCK TRANSFERS)
model StockTransfer {
