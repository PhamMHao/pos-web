datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// 1. NGƯỜI DÙNG & PHÂN QUYỀN
model User {
  id           String      @id @default(uuid())
  username     String      @unique
  passwordHash String
  fullName     String
  email        String?
  phone        String?
  role         String      // 'Admin' | 'Thu Ngân' | 'Thủ Kho' | 'Kế Toán' | 'Quản Lý' | 'Bán Hàng'
  status       String      @default("active") // 'active' | 'inactive'
  avatar       String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  shifts       CashShift[]
  createdExchanges ProductExchange[] @relation("ExchangeCreatedBy")
  createdReturns   ReturnOrder[]     @relation("ReturnCreatedBy")

  @@map("NguoiDung")
}

// 1.1. PHÂN QUYỀN & VAI TRÒ HỆ THỐNG (RBAC)
model RolePermission {
  id          String   @id @default(uuid())
  roleKey     String   @unique
  roleNameVi  String
  description String?  @db.NVarChar(Max)
  badgeColor  String?
  gradient    String?
  defaultTab  String?  @default("pos")
  permissions String   @db.NVarChar(Max)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("PhanQuyenVaiTro")
}

model SystemModule {
  id          String   @id
  label       String
  category    String
  description String?  @db.NVarChar(Max)
  orderIndex  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("DanhMucPhanHe")
}

// 2. SẢN PHẨM & ĐƠN VỊ TÍNH QUY ĐỔI (MULTI-UOM)
model Product {
  id              String                 @id @default(uuid())
  sku             String                 @unique
  barcode         String                 @default("")
  name            String
  category        String
  unit            String                 // ĐVT cơ bản (base unit)
  costPrice       Decimal                @db.Decimal(18, 2)
  sellingPrice    Decimal                @db.Decimal(18, 2)
  stock           Decimal                @db.Decimal(18, 2)
  minStock        Decimal                @default(5) @db.Decimal(18, 2)
  image           String?
  warehouse       String                 @default("Kho Chính")
  storageLocation String?
  description     String?                @db.NVarChar(Max)
  isFeatured      Boolean                @default(false)
  weightOrVolume  String?
  specifications  String?                @db.NVarChar(Max)
  color           String?
  brand           String?
  warrantyMonths  Int?                   @default(12)
  accessories     String?                @db.NVarChar(Max)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  uomConversions  ProductUOMConversion[]
  orderItems      OrderItem[]
  receiptItems    StockGoodsReceiptItem[]
  inventoryLogs   InventoryLog[]
  returnItems      ReturnOrderItem[]
  exchangeInItems  ProductExchangeInItem[]
  exchangeOutItems ProductExchangeOutItem[]

  @@map("SanPham")
}

model ProductUOMConversion {
  id             String   @id @default(uuid())
  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  unit           String   // 'Thùng', 'Cuộn', 'Mét', 'Kg', 'Hộp'...
  ratioToBase    Decimal  @db.Decimal(18, 4) // Hệ số nhân để quy ra đơn vị cơ bản
  costPrice      Decimal  @db.Decimal(18, 2)
  sellingPrice   Decimal  @db.Decimal(18, 2)
  barcode        String?
  isBase         Boolean  @default(false)
  referenceUnit  String?
  conversionRate Decimal? @db.Decimal(18, 4)
  description    String?

  @@map("QuyDoiDonViTinh")
}

// 3. KHÁCH HÀNG & CRM
model Customer {
  id          String   @id @default(uuid())
  name        String
  phone       String   @unique
  email       String?
  address     String?
  tier        String   @default("Đồng") // 'Đồng' | 'Bạc' | 'Vàng' | 'Kim Cương'
  points      Decimal  @default(0) @db.Decimal(18, 2)
  totalSpent  Decimal  @default(0) @db.Decimal(18, 2)
  totalOrders Int      @default(0)
  debt        Decimal  @default(0) @db.Decimal(18, 2)
  note        String?  @db.NVarChar(Max)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  orders      Order[]
  returnOrders   ReturnOrder[]
  exchangeOrders ProductExchange[]
  debtLogs       CustomerDebtLog[]
  contracts      CustomerContract[]

  @@map("KhachHang")
}

// 4. BÁN HÀNG POS & ĐƠN HÀNG
model Order {
  id              String      @id @default(uuid())
  code            String      @unique // e.g. DH-10029
  channel         String      @default("Tại quầy (POS)")
  status          String      @default("completed") // 'pending'|'confirmed'|'processing'|'shipping'|'completed'|'cancelled'|'refunded'
  customerId      String?
  customer        Customer?   @relation(fields: [customerId], references: [id])
  customerName    String?
  customerPhone   String?
  customerAddress String?
  customerRank    String?
  subtotal        Decimal     @db.Decimal(18, 2)
  discountAmount  Decimal     @default(0) @db.Decimal(18, 2)
  discountCode    String?
  taxRate         Decimal     @default(0) @db.Decimal(5, 2)
  taxAmount       Decimal     @default(0) @db.Decimal(18, 2)
  shippingFee     Decimal     @default(0) @db.Decimal(18, 2)
  shippingPartner String?
  trackingCode    String?
  total           Decimal     @db.Decimal(18, 2)
  totalCost       Decimal     @default(0) @db.Decimal(18, 2)
  profit          Decimal     @default(0) @db.Decimal(18, 2)
  paymentMethod   String      @default("cash") // 'cash'|'transfer'|'card'|'momo'|'debt'
  paymentStatus   String      @default("paid") // 'paid'|'unpaid'|'partial'
  paidAmount      Decimal     @db.Decimal(18, 2)
  changeAmount    Decimal     @default(0) @db.Decimal(18, 2)
  note            String?     @db.NVarChar(Max)
  digitalSignature String?     @db.NVarChar(Max) // JSON chữ ký số CA
  shiftId         String?
  createdAt       DateTime    @default(now())
  completedAt     DateTime?
  items           OrderItem[]
  eInvoices       EInvoice[]
  returnOrders    ReturnOrder[]
  exchangeOrders  ProductExchange[]

  @@map("HoaDon")
}

model OrderItem {
  id               String   @id @default(uuid())
  orderId          String
  order            Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId        String
  product          Product  @relation(fields: [productId], references: [id])
  productName      String
  sku              String
  unit             String
  ratioToBase      Decimal  @default(1) @db.Decimal(18, 4)
  quantity         Decimal  @db.Decimal(18, 2)
  returnedQuantity Decimal  @default(0) @db.Decimal(18, 2)
  unitPrice        Decimal  @db.Decimal(18, 2)
  costPrice        Decimal  @db.Decimal(18, 2)
  discountPercent  Decimal  @default(0) @db.Decimal(5, 2)
  total            Decimal  @db.Decimal(18, 2)
  returnItems      ReturnOrderItem[]
  exchangeInItems  ProductExchangeInItem[]

  @@map("ChiTietHoaDon")
}

// 5. CA LÀM VIỆC THU NGÂN
model CashShift {
  id                 String    @id @default(uuid())
  shiftName          String
  staffId            String?
  user               User?     @relation(fields: [staffId], references: [id])
  staffName          String
  startTime          DateTime  @default(now())
  endTime            DateTime?
  initialCash        Decimal   @db.Decimal(18, 2)
  cashSales          Decimal   @default(0) @db.Decimal(18, 2)
  transferSales      Decimal   @default(0) @db.Decimal(18, 2)
  cardSales          Decimal   @default(0) @db.Decimal(18, 2)
  otherSales         Decimal   @default(0) @db.Decimal(18, 2)
  totalSales         Decimal   @default(0) @db.Decimal(18, 2)
  cashWithdrawals    Decimal   @default(0) @db.Decimal(18, 2)
  expectedEndingCash Decimal   @default(0) @db.Decimal(18, 2)
  actualEndingCash   Decimal?  @db.Decimal(18, 2)
  note               String?   @db.NVarChar(Max)
  status             String    @default("open") // 'open' | 'closed'

  @@map("CaBanHang")
}

// 6. NHẬT KÝ KHO & PHIẾU NHẬP KHO
model InventoryLog {
  id             String   @id @default(uuid())
  productId      String
  product        Product  @relation(fields: [productId], references: [id])
  productName    String
  sku            String
  type           String   // 'import' | 'export' | 'audit_adjustment' | 'sale_deduct'
  quantityChange Decimal  @db.Decimal(18, 2)
  oldStock       Decimal  @db.Decimal(18, 2)
  newStock       Decimal  @db.Decimal(18, 2)
  unitPrice      Decimal? @db.Decimal(18, 2)
  reason         String   @db.NVarChar(Max)
  performedBy    String
  timestamp      DateTime @default(now())

  @@map("NhatKyKho")
}

model StockGoodsReceipt {
  id                 String                  @id @default(uuid())
  code               String                  @unique // e.g. PNK-2026-0816-001
  date               DateTime                @default(now())
  sourceType         String?                 @default("manual") // 'po' | 'quote' | 'inbound_invoice' | 'manual'
  sourceId           String?
  sourceCode         String?
  inboundInvoiceId   String?
  inboundInvoiceCode String?
  supplierName       String
  supplierTaxCode    String?
  supplierPhone      String?
  supplierAddress    String?
  warehouseName      String                  @default("Kho Chính")
  creatorName        String
  receivedBy         String
  totalItemsCount    Int
  totalQuantity      Decimal                 @db.Decimal(18, 2)
  totalCostAmount    Decimal                 @db.Decimal(18, 2)
  totalTaxAmount     Decimal                 @default(0) @db.Decimal(18, 2)
  grandTotal         Decimal                 @db.Decimal(18, 2)
  paymentStatus      String                  @default("paid") // 'paid' | 'debt_pending' | 'partial'
  notes              String?                 @db.NVarChar(Max)
  items              StockGoodsReceiptItem[]

  @@map("PhieuNhapKho")
}

model StockGoodsReceiptItem {
  id              String            @id @default(uuid())
  receiptId       String
  receipt         StockGoodsReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  productId       String
  product         Product           @relation(fields: [productId], references: [id])
  productName     String
  sku             String
  unit            String
  quantity        Decimal           @db.Decimal(18, 2)
  oldStock        Decimal           @db.Decimal(18, 2)
  newStock        Decimal           @db.Decimal(18, 2)
  oldCostPrice    Decimal           @db.Decimal(18, 2)
  newCostPrice    Decimal           @db.Decimal(18, 2)
  unitCost        Decimal           @db.Decimal(18, 2)
  taxRate         Decimal           @default(0) @db.Decimal(5, 2)
  totalAmount     Decimal           @db.Decimal(18, 2)
  storageLocation String?
  warehouse       String?
  category        String?
  specifications  String?           @db.NVarChar(Max)
  color           String?
  brand           String?
  warrantyMonths  Int?              @default(12)
  accessories     String?           @db.NVarChar(Max)
  serials         String?           @db.NVarChar(Max)
  notes           String?

  @@map("ChiTietPhieuNhapKho")
}

// 6.1 PHIẾU XUẤT KHO (STOCK GOODS ISSUE / OUTBOUND NOTE)
model StockGoodsIssue {
  id              String                @id @default(uuid())
  code            String                @unique // e.g. XK-2026-0001
  orderId         String?
  orderCode       String                // DH-10029
  customerName    String
  customerPhone   String?
  customerAddress String?
  warehouseName   String                @default("Kho Chính")
  dispatchedBy    String
  dispatchedAt    DateTime              @default(now())
  totalQuantity   Decimal               @db.Decimal(18, 2)
  totalItemsCount Int                   @default(1)
  status          String                @default("completed") // 'completed' | 'cancelled'
  notes           String?               @db.NVarChar(Max)
  createdAt       DateTime              @default(now())
  items           StockGoodsIssueItem[]

  @@map("PhieuXuatKho")
}

model StockGoodsIssueItem {
  id             String          @id @default(uuid())
  issueId        String
  issue          StockGoodsIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  productId      String
  productName    String
  sku            String
  unit           String          @default("Cái")
  quantity       Decimal         @db.Decimal(18, 2)
  serials        String?         @db.NVarChar(Max) // JSON array of serial strings
  warrantyMonths Int?            @default(12)
  notes          String?

  @@map("ChiTietPhieuXuatKho")
}

// 7. BÁO GIÁ (PRICE QUOTES)
model PriceQuote {
  id              String           @id @default(uuid())
  code            String           @unique // BG-2026-001
  customerName    String
  customerPhone   String
  customerCompany String?
  totalAmount     Decimal          @db.Decimal(18, 2)
  discountPercent Decimal          @default(0) @db.Decimal(5, 2)
  finalTotal      Decimal          @db.Decimal(18, 2)
  validUntil      DateTime
  status          String           @default("draft") // 'draft'|'sent'|'approved'|'converted_to_order'|'completed'|'rejected'
  createdAt       DateTime         @default(now())
  notes           String?          @db.NVarChar(Max)
  digitalSignature String?          @db.NVarChar(Max) // JSON chữ ký số CA
  items           PriceQuoteItem[]

  @@map("BaoGia")
}

model PriceQuoteItem {
  id          String     @id @default(uuid())
  quoteId     String
  quote       PriceQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  productName String
  sku         String
  unit        String
  quantity    Decimal    @db.Decimal(18, 2)
  unitPrice   Decimal    @db.Decimal(18, 2)
  total       Decimal    @db.Decimal(18, 2)

  @@map("ChiTietBaoGia")
}

// 8. ĐỊNH MỨC BOM & TÍNH GIÁ THÀNH
model ProductCosting {
  id                       String          @id @default(uuid())
  productName              String
  sku                      String          @unique
  rawMaterialsCost         Decimal         @db.Decimal(18, 2)
  laborCost                Decimal         @db.Decimal(18, 2)
  machineryAndOverheadCost Decimal         @db.Decimal(18, 2)
  totalStandardCost        Decimal         @db.Decimal(18, 2)
  currentSellingPrice      Decimal         @db.Decimal(18, 2)
  grossMarginPercent       Decimal         @db.Decimal(5, 2)
  lastUpdated              DateTime        @default(now())
  bomItems                 CostingBOMItem[]

  @@map("DinhMucSanXuat")
}

model CostingBOMItem {
  id           String         @id @default(uuid())
  costingId    String
  costing      ProductCosting @relation(fields: [costingId], references: [id], onDelete: Cascade)
  materialName String
  quantity     Decimal        @db.Decimal(18, 2)
  unit         String
  unitCost     Decimal        @db.Decimal(18, 2)
  totalCost    Decimal        @db.Decimal(18, 2)

  @@map("ChiTietDinhMucBOM")
}

// 9. TÀI SẢN DOANH NGHIỆP
model EnterpriseAsset {
  id                  String    @id @default(uuid())
  code                String    @unique // TS-001
  name                String
  category            String
  purchaseDate        DateTime
  originalValue       Decimal   @db.Decimal(18, 2)
  depreciationMonths  Int
  remainingValue      Decimal   @db.Decimal(18, 2)
  assignedTo          String
  status              String    @default("good") // 'good'|'maintenance_required'|'broken'|'liquidated'
  lastMaintenanceDate DateTime?

  @@map("TaiSanDoanhNghiep")
}

// 10. BẢO HÀNH & SERIAL/IMEI
model WarrantyTicket {
  id                      String                  @id @default(uuid())
  code                    String                  @unique // BH-2026-001
  type                    String                  @default("warranty") // 'warranty'|'maintenance'|'repair'
  priority                String                  @default("normal") // 'low'|'normal'|'high'|'urgent'
  status                  String                  @default("received") // 'received'|'diagnosing'|'repairing'|'waiting_parts'|'sent_vendor'|'ready_to_return'|'returned'|'replaced_new'|'unrepairable'
  orderCode               String?
  productId               String?
  productName             String
  model                   String?
  serialNumber            String
  qrCodeUrl               String?
  customerName            String
  customerPhone           String
  customerAddress         String?
  customerEmail           String?
  accessoriesIncluded     String?
  cosmeticCondition       String?
  issueDescription        String                  @db.NVarChar(Max)
  technicianDiagnosis     String?                 @db.NVarChar(Max)
  resolution              String?                 @db.NVarChar(Max)
  technicianName          String
  receivedDate            DateTime                @default(now())
  expectedReturnDate      DateTime
  actualReturnDate        DateTime?
  laborCost               Decimal                 @default(0) @db.Decimal(18, 2)
  partsCost               Decimal                 @default(0) @db.Decimal(18, 2)
  discountAmount          Decimal                 @default(0) @db.Decimal(18, 2)
  totalFee                Decimal                 @default(0) @db.Decimal(18, 2)
  paymentStatus           String                  @default("free") // 'free'|'paid'|'unpaid'|'partial'
  paidAmount              Decimal                 @default(0) @db.Decimal(18, 2)
  returnedToPerson        String?
  returnNote              String?                 @db.NVarChar(Max)
  warrantyExtensionMonths Int                     @default(0)
  parts                   WarrantyPartItem[]
  timeline                WarrantyTimelineEvent[]

  @@map("PhieuBaoHanh")
}

model WarrantyPartItem {
  id              String         @id @default(uuid())
  warrantyId      String
  warranty        WarrantyTicket @relation(fields: [warrantyId], references: [id], onDelete: Cascade)
  partName        String
  sku             String?
  quantity        Decimal        @db.Decimal(18, 2)
  unit            String
  unitPrice       Decimal        @db.Decimal(18, 2)
  isUnderWarranty Boolean        @default(true)
  warrantyMonths  Int            @default(0)

  @@map("LinhKienBaoHanh")
}

model WarrantyTimelineEvent {
  id         String         @id @default(uuid())
  warrantyId String
  warranty   WarrantyTicket @relation(fields: [warrantyId], references: [id], onDelete: Cascade)
  timestamp  DateTime       @default(now())
  action     String
  actor      String
  notes      String?        @db.NVarChar(Max)
  status     String

  @@map("NhatKyBaoHanh")
}

model SerialDeviceRecord {
  id                     String    @id @default(uuid())
  serialNumber           String    @unique
  productId              String?
  productName            String
  sku                    String
  brand                  String?
  color                  String?
  specifications         String?   @db.NVarChar(Max)
  accessories            String?   @db.NVarChar(Max)
  status                 String    @default("in_stock") // 'in_stock' | 'reserved' | 'sold' | 'under_warranty' | 'defective' | 'returned_to_vendor'
  warehouseName          String?   @default("Kho Chính")
  storageLocation        String?
  receiptCode            String?
  receiptDate            DateTime?
  soldOrderCode          String?
  soldDate               DateTime?
  customerName           String?
  customerPhone          String?
  customerAddress        String?
  warrantyPeriodMonths   Int       @default(12)
  warrantyExpiryDate     DateTime?
  warrantyStatus         String    @default("valid") // 'valid' | 'expired' | 'voided'
  totalRepairsCount      Int       @default(0)
  totalMaintenancesCount Int       @default(0)
  notes                  String?   @db.NVarChar(Max)

  @@map("SoSerialThietBi")
}

// 11. HÓA ĐƠN ĐIỆN TỬ (TT78) & ĐẦU VÀO XML
model EInvoice {
  id               String         @id @default(uuid())
  invoiceCode      String         @unique // 1C26TGP-00000088
  invoiceNumber    String
  invoiceSymbol    String         // 1C26TGP
  invoiceTemplate  String         // 1/001
  invoiceType      String         @default("vat") // 'vat' | 'sales'
  cqtCode          String?
  lookupCode       String         @unique
  lookupUrl        String
  issueDate        DateTime       @default(now())
  signDate         DateTime?
  status           String         @default("draft") // 'draft'|'signed'|'sent_cqt'|'cqt_approved'|'cancelled'|'adjusted'
  orderId          String?
  order            Order?         @relation(fields: [orderId], references: [id])
  orderCode        String?
  sellerData       String         @db.NVarChar(Max) // JSON
  buyerData        String         @db.NVarChar(Max) // JSON
  subtotal         Decimal        @db.Decimal(18, 2)
  discountAmount   Decimal        @default(0) @db.Decimal(18, 2)
  taxRate          Decimal        @db.Decimal(5, 2)
  taxAmount        Decimal        @db.Decimal(18, 2)
  totalAmount      Decimal        @db.Decimal(18, 2)
  amountInWords    String
  paymentMethod    String         @default("TM/CK")
  notes            String?        @db.NVarChar(Max)
  digitalSignature String?        @db.NVarChar(Max) // JSON
  cqtStatusMessage String?
  items            EInvoiceItem[]

  @@map("HoaDonDienTu")
}

model EInvoiceItem {
  id              String   @id @default(uuid())
  invoiceId       String
  invoice         EInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  sku             String
  productName     String
  unit            String
  quantity        Decimal  @db.Decimal(18, 2)
  unitPrice       Decimal  @db.Decimal(18, 2)
  subtotal        Decimal  @db.Decimal(18, 2)
  discountPercent Decimal  @default(0) @db.Decimal(5, 2)
  discountAmount  Decimal  @default(0) @db.Decimal(18, 2)
  taxRate         Decimal  @db.Decimal(5, 2)
  taxAmount       Decimal  @db.Decimal(18, 2)
  total           Decimal  @db.Decimal(18, 2)

  @@map("ChiTietHoaDonDienTu")
}

model InboundEInvoice {
  id                 String               @id @default(uuid())
  source             String               @default("xml_upload") // 'cqt_portal'|'gmail_sync'|'xml_upload'
  sourceDetail       String?
  sourceFile         String?
  invoiceCode        String               @unique
  invoiceNumber      String
  invoiceSymbol      String
  invoiceTemplate    String
  issueDate          DateTime
  receivedDate       DateTime             @default(now())
  cqtCode            String?
  lookupCode         String?
  lookupUrl          String?
  sellerData         String               @db.NVarChar(Max) // JSON
  buyerData          String               @db.NVarChar(Max) // JSON
  subtotal           Decimal              @db.Decimal(18, 2)
  taxRate            Decimal              @db.Decimal(5, 2)
  taxAmount          Decimal              @db.Decimal(18, 2)
  totalAmount        Decimal              @db.Decimal(18, 2)
  amountInWords      String
  status             String               @default("pending_review") // 'pending_review'|'matched'|'imported_to_stock'|'rejected'
  goodsReceiptId     String?
  importedAt         DateTime?
  importedBy         String?
  targetWarehouse    String?
  accountingRecordId String?
  notes              String?              @db.NVarChar(Max)
  rawXmlContent      String?              @db.NVarChar(Max)
  items              InboundInvoiceItem[]

  @@map("HoaDonDauVao")
}

model InboundInvoiceItem {
  id                      String          @id @default(uuid())
  inboundInvoiceId        String
  inboundInvoice          InboundEInvoice @relation(fields: [inboundInvoiceId], references: [id], onDelete: Cascade)
  lineNumber              Int
  productName             String
  skuOrCode               String?
  unit                    String
  quantity                Decimal         @db.Decimal(18, 2)
  unitPrice               Decimal         @db.Decimal(18, 2)
  subtotal                Decimal         @db.Decimal(18, 2)
  taxRate                 Decimal         @db.Decimal(5, 2)
  taxAmount               Decimal         @db.Decimal(18, 2)
  total                   Decimal         @db.Decimal(18, 2)
  matchedProductId        String?
  matchedProductName      String?
  matchedProductSku       String?
  currentStock            Decimal?        @db.Decimal(18, 2)
  currentCostPrice        Decimal?        @db.Decimal(18, 2)
  ratioToBaseUnit         Decimal         @default(1) @db.Decimal(18, 4)
  isNewProduct            Boolean         @default(false)
  status                  String          @default("unmatched") // 'matched'|'unmatched'|'needs_create'|'ignored'
  assignedCategory        String?
  assignedWarehouse       String?
  assignedStorageLocation String?
  suggestedSellingPrice   Decimal?        @db.Decimal(18, 2)
  customSku               String?
  customBarcode           String?

  @@map("ChiTietHoaDonDauVao")
}

// 12. HỢP ĐỒNG LAO ĐỘNG & NHÂN SỰ HR
model LaborContract {
  id             String   @id @default(uuid())
  contractNumber String   @unique // HĐLĐ-2026/GP-001
  employeeId     String
  employeeCode   String
  employeeName   String
  employeeRole   String
  contractType   String
  startDate      DateTime
  endDate        DateTime?
  signDate       DateTime @default(now())
  status         String   @default("active") // 'draft'|'sent_for_signature'|'signed'|'active'|'expired'|'terminated'
  employerData   String   @db.NVarChar(Max) // JSON
