  currentSales   Decimal  @default(0) @db.Decimal(18, 2)
  commissionRate Decimal  @default(0) @db.Decimal(5, 2) // %
  status         String   @default("active") // 'active' | 'leave' | 'inactive'
  avatar         String?
  joinedDate     DateTime @default(now())
  shiftSchedule  String?

  @@map("NhanVien")
}

model KpiEvaluationRecord {
  id                     String    @id @default(uuid())
  employeeId             String
  employeeCode           String
  employeeName           String
  role                   String
  department             String
  period                 String    // 'Tháng 02/2026', 'Quý 1/2026'
  evaluationDate         DateTime  @default(now())
  criteriaJson           String    @db.NVarChar(Max)
  selfTotalScore         Decimal   @db.Decimal(5, 2)
  managerTotalScore      Decimal   @db.Decimal(5, 2)
  finalScore             Decimal   @db.Decimal(5, 2)
  rank                   String    // 'A+', 'A', 'B', 'C', 'D'
  baseSalary             Decimal   @db.Decimal(18, 2)
  salesRevenue           Decimal   @default(0) @db.Decimal(18, 2)
  commissionRate         Decimal   @default(0) @db.Decimal(5, 2)
  commissionAmount       Decimal   @default(0) @db.Decimal(18, 2)
  performanceBonusRate   Decimal   @default(0) @db.Decimal(5, 2)
  performanceBonus       Decimal   @default(0) @db.Decimal(18, 2)
  attendanceBonus        Decimal   @default(0) @db.Decimal(18, 2)
  initiativeBonus        Decimal   @default(0) @db.Decimal(18, 2)
  totalGrossPayout       Decimal   @default(0) @db.Decimal(18, 2)
  employeeStrengths      String?   @db.NVarChar(Max)
  employeeImprovements   String?   @db.NVarChar(Max)
  developmentPlan        String?   @db.NVarChar(Max)
  directorApprovalStatus String    @default("pending") // 'pending' | 'approved' | 'rejected'
  approvedBy             String?
  approvedAt             DateTime?
  digitalSignature       String?   @db.NVarChar(Max)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@map("DanhGiaKPI")
}

// 13. KẾ TOÁN, KHUYẾN MÃI, CẢNH BÁO FRAUD & CÀI ĐẶT
model AccountingRecord {
  id            String   @id @default(uuid())
  code          String   @unique
  type          String   // 'income' | 'expense'
  category      String   // 'Bán hàng'|'Nhập hàng'|'Chi lương nhân viên'|'Thuế VAT'|'Mặt bằng & Điện nước'|'Thu nợ khách'|'Khác'
  amount        Decimal  @db.Decimal(18, 2)
  date          DateTime @default(now())
  party         String   // Đối tác / Khách hàng / NCC
  paymentMethod String   @default("cash")
  status        String   @default("completed")
  note          String?  @db.NVarChar(Max)
  receiptNumber String?

  @@map("SoThuChiKeToan")
}

model Promotion {
  id            String   @id @default(uuid())
  code          String   @unique
  title         String
  discountType  String   // 'percentage' | 'fixed'
  discountValue Decimal  @db.Decimal(18, 2)
  minOrderValue Decimal  @default(0) @db.Decimal(18, 2)
  maxDiscount   Decimal? @db.Decimal(18, 2)
  usageLimit    Int      @default(100)
  usedCount     Int      @default(0)
  startDate     DateTime
  endDate       DateTime
  isActive      Boolean  @default(true)

  @@map("ChuongTrinhKhuyenMai")
}

model FraudAlert {
  id              String   @id @default(uuid())
  severity        String   // 'high' | 'medium' | 'low'
  title           String
  description     String   @db.NVarChar(Max)
  timestamp       DateTime @default(now())
  source          String   // 'POS' | 'CashShift' | 'Inventory' | 'Accounting'
  status          String   @default("unresolved") // 'unresolved' | 'investigating' | 'resolved'
  suggestedAction String   @db.NVarChar(Max)

  @@map("CanhBaoGianLan")
}

model StoreSettings {
  id           String   @id @default("default_settings")
  storeName    String   @default("GP-ERP Enterprise")
  tagline      String?
  phone        String?
  email        String?
  address      String?
  taxCode      String?
  bankName     String?
  bankAccount  String?
  bankCode     String?
  settingsJson String   @db.NVarChar(Max) // Lưu toàn bộ JSON cấu hình mở rộng (in ấn, máy in, scanner, ...)
  updatedAt    DateTime @updatedAt

  @@map("CauHinhCuaHang")
}

// 14. NHÀ CUNG CẤP & BẢNG GIÁ ĐỐI TÁC
model Supplier {
  id             String               @id @default(uuid())
  code           String               @unique // NCC-001
  name           String
  taxCode        String?
  tier           String               @default("Tổng Đại Lý") // 'Tier 1 Chính Hãng' | 'Tổng Đại Lý' | 'Nhà Phân Phối'
  category       String               @default("Camera & An Ninh")
  contactPerson  String?
  phone          String
  email          String?
  address        String?
  bankName       String?
  bankAccount    String?
  bankCode       String?
  creditLimit    Decimal              @default(0) @db.Decimal(18, 2)
  creditDays     Int                  @default(30)
  currentDebt    Decimal              @default(0) @db.Decimal(18, 2)
  ratingQuality  Decimal              @default(9.5) @db.Decimal(4, 2)
  ratingPrice    Decimal              @default(9.0) @db.Decimal(4, 2)
  ratingOnTime   Decimal              @default(9.5) @db.Decimal(4, 2)
  ratingWarranty Decimal              @default(9.2) @db.Decimal(4, 2)
  notes          String?              @db.NVarChar(Max)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  priceList      SupplierPriceItem[]
  purchaseOrders PurchaseOrder[]

  @@map("NhaCungCap")
}

model SupplierPriceItem {
  id             String   @id @default(uuid())
  supplierId     String
  supplier       Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  sku            String
  productName    String
  costPrice      Decimal  @db.Decimal(18, 2)
  warrantyMonths Int      @default(24)
  moq            Int      @default(1)

  @@map("BangGiaNhaCungCap")
}

// 15. ĐƠN ĐẶT HÀNG MUA (PURCHASE ORDERS - PO)
model PurchaseOrder {
  id                   String              @id @default(uuid())
  code                 String              @unique // PO-2026-0001
  supplierId           String
  supplier             Supplier            @relation(fields: [supplierId], references: [id])
  supplierName         String
  supplierPhone        String?
  supplierAddress      String?
  supplierTaxCode      String?
  warehouseId          String              @default("wh-main")
  warehouseName        String              @default("Kho Chính")
  orderDate            DateTime            @default(now())
  expectedDeliveryDate DateTime
  status               String              @default("confirmed") // 'draft'|'sent'|'confirmed'|'partially_received'|'completed'|'cancelled'
  subtotal             Decimal             @db.Decimal(18, 2)
  vatRate              Decimal             @default(10) @db.Decimal(5, 2)
  vatAmount            Decimal             @default(0) @db.Decimal(18, 2)
  shippingFee          Decimal             @default(0) @db.Decimal(18, 2)
  discountAmount       Decimal             @default(0) @db.Decimal(18, 2)
  totalAmount          Decimal             @db.Decimal(18, 2)
  paidAmount           Decimal             @default(0) @db.Decimal(18, 2)
  paymentStatus        String              @default("unpaid") // 'unpaid'|'partial'|'paid'
  paymentMethod        String              @default("transfer")
  notes                String?             @db.NVarChar(Max)
  projectId            String?
  projectCode          String?
  projectName          String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  items                PurchaseOrderItem[]

  @@map("DonDatHangMua")
}

model PurchaseOrderItem {
  id              String        @id @default(uuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId       String?
  sku             String
  productName     String
  unit            String        @default("Cái")
  quantity        Decimal       @db.Decimal(18, 2)
  unitPrice       Decimal       @db.Decimal(18, 2)
  total           Decimal       @db.Decimal(18, 2)

  @@map("ChiTietDonDatHangMua")
}

// ==========================================
// 16. CHÍNH SÁCH ĐỔI TRẢ & BÚT TOÁN KẾ TOÁN KÉP & ĐỔI TRẢ HÀNG
// ==========================================

// 16.0 CẤU HÌNH CHÍNH SÁCH ĐỔI TRẢ
model ReturnPolicyConfig {
  id                      String   @id @default("default_policy")
  returnPeriodDays        Int      @default(15) // Hạn trả hàng (ngày)
  exchangePeriodDays      Int      @default(30) // Hạn đổi hàng (ngày)
  approvalThresholdAmount Decimal  @default(10000000) @db.Decimal(18, 2) // Ngưỡng duyệt (10tr)
  restockingFeeDamagedBox Decimal  @default(10) @db.Decimal(5, 2) // % phí mở seal/hộp
  restockingFeeUsed       Decimal  @default(20) @db.Decimal(5, 2) // % phí đã dùng/trầy xước
  allowNoReceiptReturn    Boolean  @default(false)
  updatedAt               DateTime @updatedAt

  @@map("CauHinhChinhSachDoiTra")
}

// 16.1 BÚT TOÁN KẾ TOÁN KÉP (DOUBLE-ENTRY JOURNAL ENTRIES)
model AccountingJournalEntry {
  id          String             @id @default(uuid())
  entryCode   String             @unique // PKT-2026-0001
  entryDate   DateTime           @default(now())
  docType     String             // 'sales_return' | 'product_exchange' | 'sales_invoice'
  docId       String
  docCode     String
  description String             @db.NVarChar(Max)
  totalDebit  Decimal            @db.Decimal(18, 2)
  totalCredit Decimal            @db.Decimal(18, 2)
  postedBy    String
  createdAt   DateTime           @default(now())
  lines       JournalEntryLine[]

  @@index([docCode])
  @@index([entryDate])
  @@map("SoNhatKyChung")
}

model JournalEntryLine {
  id           String                 @id @default(uuid())
  entryId      String
  entry        AccountingJournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  accountCode  String                 // '5212' | '33311' | '131' | '111' | '112' | '632' | '156' | '511'
  accountName  String
  debitAmount  Decimal                @default(0) @db.Decimal(18, 2)
  creditAmount Decimal                @default(0) @db.Decimal(18, 2)
  description  String?
  partyId      String?
  partyName    String?
  productId    String?
  orderId      String?

  @@index([accountCode])
  @@index([entryId])
  @@map("ChiTietSoNhatKy")
}

// 16.2 PHIẾU TRẢ HÀNG & HOÀN TIỀN (CUSTOMER RETURN)
model ReturnOrder {
  id                  String            @id @default(uuid())
  code                String            @unique // TH-2026-0828-001
  type                String            @default("customer_return")
  originalOrderId     String?
  originalOrder       Order?            @relation(fields: [originalOrderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  originalOrderCode   String?
  customerId          String?
  customer            Customer?         @relation(fields: [customerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  customerName        String
  customerPhone       String?
  warehouse           String            @default("Kho Chính")
  
  subtotal            Decimal           @default(0) @db.Decimal(18, 2)
  taxAmount           Decimal           @default(0) @db.Decimal(18, 2)
  restockingFee       Decimal           @default(0) @db.Decimal(18, 2)
  giftDeductionAmount Decimal           @default(0) @db.Decimal(18, 2)
  refundAmount        Decimal           @db.Decimal(18, 2) // Tiền thực hoàn cho khách
  totalReturnQuantity Decimal           @db.Decimal(18, 2)
  
  refundMethod        String            @default("cash") // 'cash' | 'transfer' | 'debt_deduct' | 'no_refund'
  accountingCode      String?           // Mã phiếu chi PC-TH-...
  stockReceiptCode    String?           // Mã phiếu nhập kho PNK-TH-...
  reason              String            // 'defective' | 'customer_mind_change' | 'wrong_item' | 'other'
  
  status              String            @default("draft") // 'draft' | 'pending_approval' | 'completed' | 'cancelled'
  idempotencyKey      String            @unique @default("legacy")
  createdBy           String            @default("system")
  createdByUser       User?             @relation("ReturnCreatedBy", fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  approvedBy          String?
  approvedAt          DateTime?
  cancelledBy         String?
  cancelledAt         DateTime?
  cancelReason        String?           @db.NVarChar(Max)
  notes               String?           @db.NVarChar(Max)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  
  items               ReturnOrderItem[]

  @@index([customerId])
  @@index([originalOrderCode])
  @@index([createdAt])
  @@index([status])
  @@map("PhieuTraHang")
}

model ReturnOrderItem {
  id                  String              @id @default(uuid())
  returnOrderId       String
  returnOrder         ReturnOrder         @relation(fields: [returnOrderId], references: [id], onDelete: Cascade)
  originalOrderItemId String?
  originalOrderItem   OrderItem?          @relation(fields: [originalOrderItemId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  productId           String
  product             Product             @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  productName         String
  sku                 String
  unit                String              @default("Cái")
  ratioToBase         Decimal             @default(1) @db.Decimal(18, 4)
  quantity            Decimal             @db.Decimal(18, 2)
  costPrice           Decimal             @default(0) @db.Decimal(18, 2) // GIÁ VỐN NHẬP LẠI KHO
  unitPrice           Decimal             @db.Decimal(18, 2)
  refundUnitPrice     Decimal             @db.Decimal(18, 2)
  taxRate             Decimal             @default(0) @db.Decimal(5, 2)
  taxAmount           Decimal             @default(0) @db.Decimal(18, 2)
  subtotal            Decimal             @default(0) @db.Decimal(18, 2)
  totalRefund         Decimal             @db.Decimal(18, 2)
  condition           String              @default("normal") // 'normal' | 'damaged' | 'unopened'
  destinationType     String              @default("restock") // 'restock' | 'faulty_warehouse'
  warehouseId         String?
  warehouse           MasterWarehouse?    @relation(fields: [warehouseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  warehouseName       String              @default("Kho Chính")
  storageLocation     String?
  specifications      String?             @db.NVarChar(Max)
  color               String?
  brand               String?
  notes               String?
  serials             ReturnItemSerial[]

  @@index([originalOrderItemId])
  @@index([productId])
  @@index([returnOrderId])
  @@map("ChiTietPhieuTraHang")
}

model ReturnItemSerial {
  id           String          @id @default(uuid())
  returnItemId String
  returnItem   ReturnOrderItem @relation(fields: [returnItemId], references: [id], onDelete: Cascade)
  serialNumber String

  @@index([serialNumber])
  @@map("ChiTietSerialTraHang")
}

// 16.3 PHIẾU ĐỔI HÀNG 2 CHIỀU (PRODUCT EXCHANGE)
model ProductExchange {
  id                  String                    @id @default(uuid())
  code                String                    @unique // DH-2026-0828-001
  originalOrderId     String?
  originalOrder       Order?                    @relation(fields: [originalOrderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  originalOrderCode   String?
  customerId          String?
  customer            Customer?                 @relation(fields: [customerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  customerName        String
  customerPhone       String?
  customerAddress     String?
  warehouseName       String                    @default("Kho Chính")
  
  inboundSubtotal     Decimal                   @db.Decimal(18, 2)
  inboundTaxAmount    Decimal                   @default(0) @db.Decimal(18, 2)
  inboundTotalAmount  Decimal                   @db.Decimal(18, 2) // V_nhap
  
  outboundSubtotal    Decimal                   @db.Decimal(18, 2)
  outboundTaxAmount   Decimal                   @default(0) @db.Decimal(18, 2)
  outboundTotalAmount Decimal                   @db.Decimal(18, 2) // V_xuat
  
  restockingFee       Decimal                   @default(0) @db.Decimal(18, 2)
  giftDeductionAmount Decimal                   @default(0) @db.Decimal(18, 2)
  differenceAmount    Decimal                   @db.Decimal(18, 2) // V_xuat - V_nhap + restockingFee + giftDeductionAmount
  
  paymentAction       String                    @default("even") // 'collect_difference' | 'refund_difference' | 'even'
  paymentMethod       String                    @default("cash") // 'cash' | 'transfer' | 'debt_adjust'
  accountingCode      String?                   // PT-DH-... / PC-DH-...
  inboundReceiptCode  String?                   // PNK-DH-...
  outboundIssueCode   String?                   // PXK-DH-...
  
  status              String                    @default("draft") // 'draft' | 'pending_approval' | 'completed' | 'cancelled'
  idempotencyKey      String                    @unique // Bắt buộc NOT NULL
  createdBy           String                    @default("system")
  createdByUser       User?                     @relation("ExchangeCreatedBy", fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  approvedBy          String?
  approvedAt          DateTime?
  cancelledBy         String?
  cancelledAt         DateTime?
  cancelReason        String?                   @db.NVarChar(Max)
  reason              String                    @default("other") // 'defective_exchange' | 'upgrade_model' | 'color_size_change' | 'other'
  notes               String?                   @db.NVarChar(Max)
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  
  inItems             ProductExchangeInItem[]
  outItems            ProductExchangeOutItem[]

  @@index([customerId])
  @@index([originalOrderCode])
  @@index([createdAt])
  @@index([status])
  @@map("PhieuDoiHang")
}

model ProductExchangeInItem {
  id                  String                      @id @default(uuid())
  exchangeId          String
  exchange            ProductExchange             @relation(fields: [exchangeId], references: [id], onDelete: Cascade)
  originalOrderItemId String?
  originalOrderItem   OrderItem?                  @relation(fields: [originalOrderItemId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  productId           String
  product             Product                     @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  productName         String
  sku                 String
  unit                String                      @default("Cái")
  ratioToBase         Decimal                     @default(1) @db.Decimal(18, 4)
  quantity            Decimal                     @db.Decimal(18, 2)
  costPrice           Decimal                     @db.Decimal(18, 2) // Giá vốn nhập lại kho
  returnUnitPrice     Decimal                     @db.Decimal(18, 2)
  taxRate             Decimal                     @default(0) @db.Decimal(5, 2)
  taxAmount           Decimal                     @default(0) @db.Decimal(18, 2)
  subtotal            Decimal                     @db.Decimal(18, 2)
  totalAmount         Decimal                     @db.Decimal(18, 2)
  condition           String                      @default("normal") // 'normal' | 'damaged' | 'unopened'
  destinationType     String                      @default("restock") // 'restock' | 'faulty_warehouse'
  warehouseId         String?
  warehouse           MasterWarehouse?            @relation(fields: [warehouseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  warehouseName       String                      @default("Kho Chính")
  storageLocation     String?
  specifications      String?                     @db.NVarChar(Max)
  color               String?
  brand               String?
  notes               String?
  serials             ProductExchangeInSerial[]

  @@index([originalOrderItemId])
  @@index([productId])
  @@index([exchangeId])
  @@map("ChiTietDoiHangNhan")
}

model ProductExchangeInSerial {
  id           String                @id @default(uuid())
  inItemId     String
  inItem       ProductExchangeInItem @relation(fields: [inItemId], references: [id], onDelete: Cascade)
  serialNumber String

  @@index([serialNumber])
  @@map("ChiTietSerialDoiHangNhan")
}

model ProductExchangeOutItem {
  id                String                       @id @default(uuid())
  exchangeId        String
  exchange          ProductExchange              @relation(fields: [exchangeId], references: [id], onDelete: Cascade)
  productId         String
  product           Product                      @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  productName       String
  sku               String
  unit              String                       @default("Cái")
  ratioToBase       Decimal                      @default(1) @db.Decimal(18, 4)
  quantity          Decimal                      @db.Decimal(18, 2)
  costPrice         Decimal                      @db.Decimal(18, 2)
  exchangeUnitPrice Decimal                      @db.Decimal(18, 2)
  taxRate           Decimal                      @default(0) @db.Decimal(5, 2)
  taxAmount         Decimal                      @default(0) @db.Decimal(18, 2)
  subtotal          Decimal                      @db.Decimal(18, 2)
  totalAmount       Decimal                      @db.Decimal(18, 2)
  warehouseId       String?
  warehouse         MasterWarehouse?             @relation(fields: [warehouseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  warehouseName     String                       @default("Kho Chính")
  warrantyMonths    Int?                         @default(12)
  specifications    String?                      @db.NVarChar(Max)
  color             String?
  brand             String?
  notes             String?
  serials           ProductExchangeOutSerial[]

  @@index([productId])
  @@index([exchangeId])
  @@map("ChiTietDoiHangXuat")
}

model ProductExchangeOutSerial {
  id           String                 @id @default(uuid())
  outItemId    String
  outItem      ProductExchangeOutItem @relation(fields: [outItemId], references: [id], onDelete: Cascade)
  serialNumber String

  @@index([serialNumber])
  @@map("ChiTietSerialDoiHangXuat")
}

// 16.4 SỔ LỊCH SỬ CÔNG NỢ & SERIAL
model CustomerDebtLog {
  id             String   @id @default(uuid())
  customerId     String
  customer       Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
